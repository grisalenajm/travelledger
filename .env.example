# .env.example — Ledger
# Copiar a .env y rellenar los valores reales.
# NUNCA commitear el .env con datos reales.
# ─────────────────────────────────────────────────────────────────

# ─── Base de datos ────────────────────────────────────────────────
# Contenedor postgres-ledger en el NAS UGREEN — puerto 5433.
# NO usar postgres-vectorchord ni ningún otro Postgres del NAS.
#
# Crear antes de arrancar (ejecutar en el NAS):
#   docker exec postgres-ledger psql -U postgres \
#     -c "CREATE USER ledger_user WITH PASSWORD 'cambia-esto';"
#   docker exec postgres-ledger psql -U postgres \
#     -c "CREATE DATABASE ledger OWNER ledger_user;"
DATABASE_URL=postgresql+asyncpg://ledger_user:cambia-esto@YOUR_NAS_IP:5433/ledger

# ─── JWT ─────────────────────────────────────────────────────────
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-en-produccion-minimo-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Paperless-ngx (en NAS UGREEN) ───────────────────────────────
# El token se obtiene en Paperless > Admin > Auth Token
PAPERLESS_URL=http://YOUR_NAS_IP:8010
PAPERLESS_TOKEN=tu-token-de-paperless-aqui

# ─── Claude API (OCR + Bot) ───────────────────────────────────────
# Modelo: claude-haiku-4-5-20251001
# Flujo B OCR: ~$0.003/ticket. Bot: ~$0.001/mensaje.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Unsplash (portadas automáticas de viaje) ─────────────────────
# Obtener gratis en https://unsplash.com/developers (plan gratuito: 50 req/hora)
# Dejar vacío para desactivar la feature.
UNSPLASH_ACCESS_KEY=

# ─── Telegram Bot ────────────────────────────────────────────────
# Obtener token en @BotFather con /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Shared secret entre bot y backend (servicio interno, no JWT)
# Generar: python -c "import secrets; print(secrets.token_hex(24))"
BOT_API_KEY=shared-secret-entre-bot-y-backend

# ─── Registro ─────────────────────────────────────────────────────
# false (default): solo el primer usuario puede registrarse (se convierte en admin).
# true: cualquiera puede registrarse (multi-usuario self-hosted).
ALLOW_REGISTRATION=false

# URL del webhook en producción (nginx del NAS enruta aquí)
BOT_WEBHOOK_URL=https://bot.ledger.tudominio.com/webhook

# polling = desarrollo local sin dominio público
# webhook = producción
BOT_MODE=webhook

# ─── Firebase (Push Notifications Android) ───────────────────────
# Descargar desde Firebase Console > Proyecto > Cuentas de servicio
# Se monta como volumen en docker-compose.yml
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-credentials.json

# ─── IMAP polling (importación automática de emails de viaje) ────────
# Opción más portable que Postfix pipe — funciona con cualquier servidor IMAP.
# Crea un buzón dedicado (ej. travel@yourdomain.com) y reenvía las confirmaciones.
# Dejar vacío para desactivar el polling IMAP.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=travel@yourdomain.com
IMAP_PASSWORD=cambia-esto
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_MINUTES=5
# Solo procesar emails de este remitente/dominio (dejar vacío para aceptar todos)
IMAP_SENDER_FILTER=

# ─── Webhook importación emails de viaje ─────────────────────────────
# Secreto compartido entre el script Postfix y el backend.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=cambia-esto-secreto-minimo-32-chars

# Email del usuario Ledger que recibirá los tramos importados.
# Si no se configura → se usa el primer usuario administrador.
WEBHOOK_USER_EMAIL=tu-email@example.com

# ─── SMTP (invitaciones por email) ───────────────────────────────
# Si no se configura, las invitaciones se crean pero el email NO se envía.
# El token de invitación sigue siendo válido — el admin puede copiarlo manualmente.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ledger@yourdomain.com
SMTP_PASSWORD=cambia-esto
# Nombre y dirección que aparecen como remitente
SMTP_FROM=Ledger <ledger@yourdomain.com>
# true → STARTTLS (puerto 587); false → SSL directo (puerto 465)
SMTP_TLS=true

# URL pública de la app (para construir el enlace /invite/[token] en el email)
APP_URL=http://YOUR_SERVER:3000

# ─── CORS (backend) ──────────────────────────────────────────────
# Orígenes separados por coma, sin espacios
ALLOWED_ORIGINS=https://ledger.tudominio.com,https://www.ledger.tudominio.com

# ─── Frontend (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.ledger.tudominio.com
# Generar: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esto-con-openssl-rand
NEXTAUTH_URL=https://ledger.tudominio.com

# ─── Desarrollo local ────────────────────────────────────────────
# Sobreescribir en .env.local o con docker-compose.dev.yml:
# DATABASE_URL=postgresql+asyncpg://ledger_user:ledger@192.168.1.XX:5433/ledger
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXTAUTH_URL=http://localhost:3000
# BOT_MODE=polling
# ALLOWED_ORIGINS=http://localhost:3000
