<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS obligatorio para tráfico externo (producción) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Red local RFC 1918: permitir HTTP para el servidor Ledger en LAN.
         Replace the example IP below with your actual server IP or hostname. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">10.0.0.0</domain>
    </domain-config>

    <!-- Desarrollo: emulador Android y localhost -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">10.0.2.2</domain>
            <domain includeSubdomains="false">localhost</domain>
            <domain includeSubdomains="false">127.0.0.1</domain>
        </domain-config>
    </debug-overrides>
</network-security-config>
